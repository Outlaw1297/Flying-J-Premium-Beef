# Database (Render Postgres internal URL in production)
DATABASE_URL="postgresql://user:password@localhost:5432/flying_j_beef?schema=public"

# Auth.js — use `openssl rand -base64 32` to generate
AUTH_SECRET=""
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"

# Seed (production: set before running npm run db:seed on Render)
SEED_ADMIN_EMAIL="admin@flyingjbeef.com"
SEED_ADMIN_PASSWORD=""

# Stripe (Phase 3) — use test keys from https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=""
STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Email (Phase 3+) — Resend API key optional; orders still work without it
RESEND_API_KEY=""
EMAIL_API_KEY=""
EMAIL_FROM="Flying J Premium Beef <orders@flyingjbeef.com>"
ADMIN_EMAIL="orders@flyingjbeef.com"

# Newsletter (Phase 5)
NEWSLETTER_API_KEY=""

# Support chat (Phase 6)
CRISP_WEBSITE_ID=""
