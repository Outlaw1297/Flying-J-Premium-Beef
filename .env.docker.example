# Copy to .env in the repo root:  cp .env.docker.example .env
# Then edit values before:          docker compose up -d --build

# --- Host publish port ---
APP_PORT=8090

# --- Postgres (compose service `db`) ---
POSTGRES_USER=flying_j
POSTGRES_PASSWORD=change-me-strong-db-password
POSTGRES_DB=flying_j_beef

# --- Auth (optional for Docker — auto-generated on first boot if blank) ---
# Prefer leaving blank for Portainer zero-config, or run: ./scripts/docker-init-env.sh
AUTH_SECRET=
NEXTAUTH_SECRET=
# Public URL of this deployment (no trailing slash). Example: https://beef.example.com
NEXTAUTH_URL=http://localhost:8090
AUTH_TRUST_HOST=true

# --- First-boot seed ---
# Leave SEED_ADMIN_PASSWORD blank to auto-generate (printed in web logs)
SEED_ON_START=true
SEED_ADMIN_EMAIL=admin@flyingjbeef.com
SEED_ADMIN_PASSWORD=

# --- Stripe (optional until you take card payments) ---
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRODUCT_TAX_CODE=txcd_40040013

# --- Business / pickup tax origin ---
BUSINESS_ADDRESS_LINE1=10457 Lanesboro Rd
BUSINESS_ADDRESS_LINE2=
BUSINESS_CITY=Scranton
BUSINESS_STATE=ND
BUSINESS_ZIP=58653

# --- Email (optional) ---
RESEND_API_KEY=
EMAIL_API_KEY=
EMAIL_FROM=Flying J Premium Beef <orders@flyingjbeef.com>
ADMIN_EMAIL=orders@flyingjbeef.com
SUPPORT_EMAIL=

# --- Optional integrations ---
NEXT_PUBLIC_CRISP_WEBSITE_ID=
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
